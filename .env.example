# Salin file ini ke ".env" untuk mengubah pengaturan default. Semua baris opsional.

# Alamat server. HOST=0.0.0.0 supaya bisa dibuka dari komputer lain di jaringan kantor.
# HOST=127.0.0.1
# PORT=8000

# Base URL link foto di CSV/XLSX. Kosongkan = otomatis mengikuti alamat yang dipakai untuk membuka aplikasi.
# Isi hanya kalau server berada di belakang reverse proxy/domain, mis. https://scraper.kantor.id
# PUBLIC_BASE_URL=

# LOG_LEVEL=INFO
# LOG_DIR=logs
# OUTPUT_DIR=output
